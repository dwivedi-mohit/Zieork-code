{
  "name": "zieork-desktop",
  "productName": "Zieork",
  "version": "2.5.0",
  "description": "Zieork Autonomous Neural Intelligence System — Sovereign Desktop App for Linux & Windows",
  "main": "main.js",
  "author": "Zieork Systems",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist:all": "electron-builder -wl"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zieork.desktop",
    "productName": "Zieork",
    "copyright": "Copyright © 2026 Zieork Systems",
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "../assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../assets/icon.png",
      "category": "Development;Utility;",
      "synopsis": "Autonomous Neural Intelligence System",
      "desktop": {
        "Name": "Zieork",
        "Comment": "Autonomous Neural Intelligence System",
        "Keywords": "AI;Neural;Assistant;Coding;Claude;Codex;"
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zieork"
    }
  }
}
