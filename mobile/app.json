{
  "expo": {
    "name": "Zieork",
    "slug": "zieork-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mohitdwivedi.zieork"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.mohitdwivedi.zieork"
    },
    "scheme": "zieork",
    "plugins": [
      "expo-asset"
    ]
  }
}
